# ── Supabase ──────────────────────────────────────────────────
# Project Settings > Data API. Sem elas o site roda com o
# catalogo semente e os formularios caem no WhatsApp.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de servico. So e usada em UM lugar do projeto: o lembrete
# diario da agenda (src/app/api/cron/lembretes), que roda sem
# ninguem logado e por isso nao tem sessao para a RLS validar.
# Nao importe ela em nenhum outro arquivo — o resto do site
# (catalogo, painel, formularios) nunca precisa dela.
SUPABASE_SERVICE_ROLE_KEY=

# ── Aviso por e-mail (opcional) ────────────────────────────────
# Sem a chave, o site continua funcionando normalmente: contato e
# compromisso sao gravados no banco e aparecem no /admin, so nao
# chega e-mail.
#
# O dominio do remetente precisa estar verificado no Resend.
# Use um SUBDOMINIO (send.ysraellkunzmann.com) para nao brigar
# com o SPF do e-mail principal do dominio — um dominio so pode
# ter um registro SPF, e dois se anulam.
RESEND_API_KEY=
LEAD_NOTIFY_FROM=

# Para onde vai o aviso de NOVO CONTATO do site (lead).
LEAD_NOTIFY_TO=

# Para onde vai o aviso da AGENDA (confirmacao ao criar + lembrete
# do dia). Sem isto, cai no seu Gmail por padrao.
AGENDA_NOTIFY_TO=

# Segredo que protege a rota do lembrete de compromisso
# (/api/cron/lembretes), disparado 1h30 antes do horario marcado.
#
# Quem chama essa rota de 5 em 5 minutos e um workflow do GitHub
# Actions (.github/workflows/lembretes-agenda.yml) — nao o Cron da
# Vercel, porque o plano Hobby so permite cron diario. O mesmo valor
# tem que estar cadastrado nos dois lugares:
#   1. Aqui / nas variaveis de ambiente da Vercel (a rota compara com
#      o cabecalho Authorization recebido)
#   2. Como "CRON_SECRET" nos Secrets do repositorio no GitHub
#      (Settings > Secrets and variables > Actions), de onde o
#      workflow le e manda no cabeçalho
# Gere um valor aleatorio longo, por exemplo com:
#   openssl rand -hex 32
CRON_SECRET=

# Segredo que autoriza /api/revalidar sem sessao de usuario.
#
# O /admin ja chama essa rota sozinho depois de salvar. Mas um
# imovel editado DIRETO no banco (fora do /admin — foi assim que a
# curadoria em lote de fotos/tour foi feita) nunca passa por ali, e
# um `vercel --prod` sem mudanca de codigo NAO garante pagina
# fresca: o Next restaura o cache de build da implantacao anterior,
# entao o site pode continuar servindo a versao antiga do imovel
# mesmo depois do redeploy. Chamar esta rota com o segredo resolve
# isso sem precisar publicar nada:
#   curl -X POST https://ysraellkunzmann.com/api/revalidar \
#     -H "Authorization: Bearer $REVALIDATE_SECRET" \
#     -H "Content-Type: application/json" \
#     -d '{"slug":"o-slug-do-imovel"}'
REVALIDATE_SECRET=
