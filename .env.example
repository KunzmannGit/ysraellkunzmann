# ── Supabase ──────────────────────────────────────────────────
# Project Settings > Data API. Sem elas o site roda com o
# catalogo semente e os formularios caem no WhatsApp.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de servico. So e usada em UM lugar do projeto: o lembrete
# diario da agenda (src/app/api/cron/lembretes), que roda sem
# ninguem logado e por isso nao tem sessao para a RLS validar.
# Nao importe ela em nenhum outro arquivo — o resto do site
# (catalogo, painel, formularios) nunca precisa dela.
SUPABASE_SERVICE_ROLE_KEY=

# ── Aviso por e-mail (opcional) ────────────────────────────────
# Sem a chave, o site continua funcionando normalmente: contato e
# compromisso sao gravados no banco e aparecem no /admin, so nao
# chega e-mail.
#
# O dominio do remetente precisa estar verificado no Resend.
# Use um SUBDOMINIO (send.ysraellkunzmann.com) para nao brigar
# com o SPF do e-mail principal do dominio — um dominio so pode
# ter um registro SPF, e dois se anulam.
RESEND_API_KEY=
LEAD_NOTIFY_FROM=

# Para onde vai o aviso de NOVO CONTATO do site (lead).
LEAD_NOTIFY_TO=

# Para onde vai o aviso da AGENDA (confirmacao ao criar + lembrete
# do dia). Sem isto, cai no seu Gmail por padrao.
AGENDA_NOTIFY_TO=

# Segredo que protege a rota do lembrete diario (/api/cron/lembretes).
# A Vercel injeta este mesmo valor como cabecalho Authorization
# quando ela mesma chama a rota pelo cron configurado em vercel.json
# — e e assim, comparando os dois, que a rota sabe que quem chamou
# foi a Vercel e nao um visitante qualquer tentando disparar e-mail
# à toa. Gere um valor aleatorio longo, por exemplo com:
#   openssl rand -hex 32
CRON_SECRET=
